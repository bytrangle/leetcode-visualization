{
  "name": "leet-years",
  "version": "0.1.0",
  "description": "Visualize your LeetCode practice history as an animated, difficulty-colored heatmap.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "leet-years": "build/bin/cli.js"
  },
  "files": [
    "build",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsx bin/cli.ts --api-only --demo\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json && chmod +x build/bin/cli.js",
    "build:web": "vite build",
    "start": "npm run build:web && tsx bin/cli.ts",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "leetcode-query": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
